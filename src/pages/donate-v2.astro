---
import { Image } from "astro:assets";
import LayoutV2 from "@/layouts/LayoutV2.astro";
import HeaderV2 from "@/components/HeaderV2.astro";
import FooterV2 from "@/components/FooterV2.astro";

import microsoftLogo from "@/assets/donors/microsoft.png";
---

<LayoutV2 title="Donate">
	<HeaderV2 />
	
	<main class="container py-4">
		<section class="donate-intro">
			<h1 class="page-title title-red mb-3">Donate</h1>
			
			<p class="intro-text mb-3">
				Each one of our many projects is 100% volunteer-run. Your donations mainly help us with:
			</p>
			
			<ul class="donation-impact-list mb-4">
				<li>Technical resources, such as tools and cloud infrastructure</li>
				<li>Expenses in hosting our typically free in-person educational and networking events that we organize to support the civic tech community at large — space, catering, etc.</li>
			</ul>
		</section>

		<section class="donate-embed-section mb-4">
			<div class="donate-embed-container mx-auto">
				<div data-zeffy-embed data-form-url="/embed/donation-form/donate-to-sf-civic-tech"></div>
				<div data-zeffy-embed-fallback style="display:none;">
					<div style="position:relative;overflow:hidden;height:450px;width:100%;"><iframe title='Donation form powered by Zeffy' style='position: absolute; border: 0; top:0;left:0;bottom:0;right:0;width:100%;height:100%' src='https://www.zeffy.com/embed/donation-form/donate-to-sf-civic-tech' {...{ allowpaymentrequest: "true", allowtransparency: "true" }}></iframe></div>
				</div>
				<script
					is:inline
					src="https://www.zeffy.com/embed/v2/zeffy-embed.js"
					onerror="document.querySelectorAll('[data-zeffy-embed-fallback]').forEach(function(el){el.style.display='block';});">
				</script>
			</div>
		</section>

		{false && (
		<section class="donors-section mt-4 pt-4">
			<h2 class="section-title title-red mb-4">Some Of Our Previous Donors</h2>
			
			<div class="donors-grid">
				<div class="donor-item">
					<Image src={microsoftLogo} alt="Microsoft Logo" class="donor-logo" width={300} />
				</div>
				<div class="donor-item placeholder-donor"></div>
				<div class="donor-item placeholder-donor"></div>
				<div class="donor-item placeholder-donor"></div>
			</div>
		</section>
		)}
	</main>

	<FooterV2 />
</LayoutV2>

<style>
	.py-4 { padding-top: 4rem; padding-bottom: 4rem; }
	.pt-4 { padding-top: 4rem; }
	.mt-4 { margin-top: 4rem; }
	.mb-3 { margin-bottom: 2rem; }
	.mb-4 { margin-bottom: 3rem; }
	.mx-auto { margin-left: auto; margin-right: auto; }

	.title-red {
		color: #F22613;
	}

	.page-title {
		font-family: var(--font-heading);
		font-size: 3rem;
		font-weight: 800;
	}

	.section-title {
		font-family: var(--font-heading);
		font-size: 2rem;
		font-weight: 800;
	}

	.donate-intro {
		max-width: 900px;
	}

	.intro-text {
		font-family: var(--font-body);
		font-size: 1.25rem;
		color: #111;
		line-height: 1.6;
	}

	.donation-impact-list {
		font-family: var(--font-body);
		font-size: 1.15rem;
		line-height: 1.6;
		color: #111;
		list-style-type: disc;
		padding-left: 2rem;
	}

	.donation-impact-list li {
		margin-bottom: 0.75rem;
	}

	/* Embed Container */
	.donate-embed-section {
		display: flex;
		justify-content: flex-start;
	}

	.donate-embed-container {
		border-radius: var(--border-radius);
		min-height: 400px;

		/* Responsiveness constraints */
		min-width: 95vw;
	}

	@media (min-width: 768px) {
		.donate-embed-container {
			min-width: 600px;
			width: 100%;
			max-width: 900px; /* To keep it from stretching endlessly */
			margin-left: 0;
		}
	}

	/* Donors Grid */
	.donors-grid {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 2rem;
	}

	.donor-item {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		max-width: 300px;
	}

	.donor-logo {
		width: 100%;
		height: auto;
		display: block;
		object-fit: contain;
	}

	.placeholder-donor {
		height: 100px; /* arbitrary height for the placeholder box */
		background-color: #f0f0f0;
		border-radius: 8px;
		border: 1px dashed #ccc;
	}
</style>
