---
import LayoutV2 from "./LayoutV2.astro";
import HeaderV2 from "@/components/HeaderV2.astro";
import FooterV2 from "@/components/FooterV2.astro";

const { frontmatter } = Astro.props;
---
<LayoutV2 title={frontmatter?.title || "Code of Conduct"}>
	<HeaderV2 />
	<main class="container py-4 markdown-content mx-auto max-w-text">
		<slot />
	</main>
	<FooterV2 />
</LayoutV2>

<style is:global>
	.max-w-text { max-width: 900px; margin-left: auto; margin-right: auto; }
	.py-4 { padding-top: 4rem; padding-bottom: 4rem; }
	.markdown-content h1 { font-family: var(--font-heading); font-size: 3rem; margin-bottom: 1.5rem; color: var(--color-primary); }
	.markdown-content h2 { font-family: var(--font-heading); font-size: 2.2rem; margin-top: 2.5rem; margin-bottom: 1rem; color: #111; }
	.markdown-content h3 { font-family: var(--font-heading); font-size: 1.5rem; margin-top: 1.5rem; margin-bottom: 1rem; color: #111; }
	.markdown-content p { font-family: var(--font-body); font-size: 1.1rem; margin-bottom: 1.5rem; line-height: 1.6; color: #222; }
	.markdown-content ul { font-family: var(--font-body); list-style: disc; padding-left: 2rem; margin-bottom: 1.5rem; font-size: 1.1rem; color: #222; line-height: 1.6; }
	.markdown-content li { margin-bottom: 0.5rem; }
	.markdown-content a { color: var(--color-primary); text-decoration: underline; }
</style>
